# Names only. Set real values with `wrangler secret put` or local `.dev.vars`.
# Never commit `.env` or `.dev.vars`.

# Worker: verify Photon → POST /channels/imessage/webhook
SPECTRUM_WEBHOOK_SECRET=

# Worker → Node sidecar (spectrum-ts). There is no public HTTP send API.
SPECTRUM_BRIDGE_URL=
SPECTRUM_BRIDGE_TOKEN=

# Optional. When set, /agents/* and /internal/* require `Authorization: Bearer <token>`.
AGENT_HTTP_TOKEN=

# Sidecar only (spectrum-sender/.env) — not loaded by the Worker:
# SPECTRUM_PROJECT_ID=
# SPECTRUM_PROJECT_SECRET=
